        "framer-motion": "14.0.0",
        "lucide-react": "^0.577.0",
        "next": "16.3.8",
        "next-themes": "0.4.6",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.0",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/postcss": "^4.3.0",
        "@types/node": "^22",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.3.8",
