{
    "name": "jeampieer-tech-portfolio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --hostname 127.0.0.1",
        "build": "next build",
        "start": "next start --hostname 127.0.0.1",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "next typegen && tsc --noEmit",
        "format": "prettier --write .",
